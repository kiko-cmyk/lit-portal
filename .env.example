# LIT Portal — environment variables (reference for restore; NO real values here)
# Set the real values in Vercel (Production/Preview/Development) and, for local
# dev + migrations, in a gitignored .env.local. Never commit real secrets.

# --- Shopify App Proxy / OAuth (customer auth) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=                 # also the App Proxy HMAC key + HKDF root for OAuth state
SHOPIFY_STORE=                      # e.g. lit-tienda.myshopify.com
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_OAUTH_STATE_SECRET=
SHOPIFY_OIDC_ISSUER=
SHOPIFY_OIDC_JWKS_URL=
SHOPIFY_WEBHOOK_SECRET=             # Shopify webhook HMAC (fail-closed if unset)

# --- Shopify Admin API (orders / customer reads) ---
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=                # static token fallback
SHOPIFY_API_KEY_ADMIN=
SHOPIFY_API_SECRET_ADMIN=

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, bypasses RLS — never expose
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # currently unused by code
DATABASE_URL=                       # local only, for `npm run migrate`

# --- Seal Subscriptions ---
SEAL_API_TOKEN=
SEAL_API_SECRET=                    # Seal webhook HMAC (primary name in prod; fail-closed if unset)
SEAL_WEBHOOK_SECRET=                # legacy fallback name for the webhook HMAC

# --- Klaviyo ---
KLAVIYO_PRIVATE_API_KEY=

# --- Reward variant ids ---
REWARD_VARIANT_BOTTLE=
REWARD_VARIANT_MERCH_HOODIE=
REWARD_VARIANT_MERCH_SOCKS=
REWARD_VARIANT_MERCH_TEE=

# --- Deploy / proxy ---
NEXT_PUBLIC_PORTAL_BASE_PATH=/apps/portal
ASSET_PREFIX_URL=                   # defaults to the prod vercel.app URL if unset
CRON_SECRET=                        # Vercel Cron bearer

# --- Safety net (added 2026-06-30) ---
SLACK_ALERTS_WEBHOOK_URL=           # 5xx alerts; falls back to SLACK_SECURITY_WEBHOOK_URL; no-op if unset
HEALTH_READY_TOKEN=                 # protects /api/health/ready
HEALTH_PROBE_SEAL_SUB_ID=           # known-good Seal sub id for the readiness probe
HEALTH_PROBE_CUSTOMER_ID=           # known-good Shopify customer GID for the readiness probe

# --- Feature flags (introduced in later batches) ---
# ALLOW_DEV_BYPASS=                  # "1" only in local dev to enable ?__dev_* impersonation
# SUBSCRIPTION_CACHE_FIRST=off       # off | shadow | on  (Lote 4)

# Slack incoming webhook del canal de INCIDENCIAS (distinto de #server-errors).
# Recibe lo que una persona tiene que atender el mismo dia: una suscripcion a un
# cobro de ser auto-cancelada por Seal, y la confirmacion cuando ya lo ha sido.
# Si no se pone, esos avisos caen en SLACK_ALERTS_WEBHOOK_URL para no perderse.
SLACK_INCIDENTS_WEBHOOK_URL=
